# Required for LLM Topic Extraction, Upper Path, Lower Path & Macro Overlay
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Required only for downloading historical news from Alpaca API
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here

# Optional: Required only for full-history Xfinlink point-in-time dumps (free tier works without key for recent 5y)
XFINLINK_API_KEY=your_xfinlink_api_key_here
